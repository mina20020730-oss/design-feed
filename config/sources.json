      "homepage": "https://www.nngroup.com/",
      "_note": "同一來源兩個 feed：一般文章 → practice，研究報告 → research。pick 用來從首頁的 feed 連結裡挑；若網站只有一個 feed，itemModeRules 會依文章網址改判模式。",
      "feeds": [
        {
          "mode": "practice",
          "defaultTags": [
            "UX"
          ],
          "discover": true,
          "pick": "article",
          "feedHints": [
            "https://www.nngroup.com/feed/rss/"
          ]
        },
        {
          "mode": "research",
          "defaultTags": [
            "UX"
          ],
          "discover": true,
          "pick": "report|research",
          "feedHints": [
            "https://www.nngroup.com/feed/rss/"
          ]
        }
      ],
      "itemModeRules": [
        {
          "match": "/reports/",
          "mode": "research"
        },
        {
          "match": "/research-",
          "mode": "research"
        }
      ],
      "skin": {
        "fontHeading": "Open Sans",
        "fontBody": "Open Sans",
        "accent": "#cc0000",
        "background": "#ffffff",
        "text": "#222222",
        "headingWeight": 700,
